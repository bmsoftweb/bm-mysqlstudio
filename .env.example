# Porta do servidor (padrão 3000)
PORT=3000

# MySQL do próprio MySQL Studio (tabelas usuarios e conexoes: sql/001_criar_tabelas.sql).
# Não é o banco que você vai administrar: esses são cadastrados na tela, como conexões.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=mysqlstudio

# Chave que assina os tokens de sessão e cifra as senhas salvas das conexões. Sem ela, uma chave aleatória
# é gerada a cada reinício: todos precisam entrar de novo e as senhas salvas deixam de abrir.
SESSION_SECRET=
